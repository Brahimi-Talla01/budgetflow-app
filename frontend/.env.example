# Copier vers frontend/.env puis renseigner les valeurs réelles.
# frontend/.env est ignoré par Git : ne jamais le committer.

# URL de l'API Flask. Le préfixe /api/v1 est ajouté automatiquement s'il manque,
# les deux écritures sont donc valides :
#   VITE_API_URL=http://127.0.0.1:5000
#   VITE_API_URL=http://127.0.0.1:5000/api/v1
VITE_API_URL=http://127.0.0.1:5000/api/v1
