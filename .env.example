# Copier vers `.env` (à la racine) puis renseigner les valeurs.
# Ce fichier est lu automatiquement par `docker compose`.

# Port public : l'application sera accessible sur http://localhost:8080
APP_PORT=8080
APP_ENV=production

# PostgreSQL embarqué (service `db`)
POSTGRES_DB=budgetflow
POSTGRES_USER=budgetflow
POSTGRES_PASSWORD=changez-moi

# Secret de signature des JWT : générer une valeur aléatoire, par exemple
#   openssl rand -hex 32
JWT_SECRET_KEY=changez-moi-egalement

# Cookies : false en HTTP local, true derrière HTTPS
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Origine autorisée à appeler l'API (l'URL que vous ouvrez dans le navigateur)
CORS_ORIGINS=http://localhost:8080

GUNICORN_WORKERS=3
