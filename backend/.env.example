[TEMPLATE]
# Copier vers backend/.env puis renseigner les valeurs réelles.
# backend/.env est ignoré par Git : ne jamais le committer.

# Application
FLASK_APP=manage.py
FLASK_DEBUG=1
APP_ENV=development

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/budgetflow

# Secret de signature des JWT — obligatoire si APP_ENV=production
JWT_SECRET_KEY=changez-cette-cle-en-production

# Session par cookie httpOnly
# Mettre JWT_COOKIE_SECURE=true en production (HTTPS obligatoire)
JWT_COOKIE_SECURE=false
# SameSite=None (+ Secure) si le frontend et l'API sont sur des domaines différents
JWT_COOKIE_SAMESITE=Lax

# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
